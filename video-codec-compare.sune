    "url": "gh://multipleof4/.sune/video-codec-compare.sune",
    "updatedAt": 1794526304720,
    "settings": {
      "html": "<!-- Sune: Video Codec Compare v1.1.0 -->\n<div id=\"vcc\" class=\"max-w-md mx-auto p-4 my-4 bg-gray-50 border border-gray-200 rounded-2xl\">\n  <div class=\"flex justify-between items-baseline\">\n    <h2 class=\"text-base font-semibold text-gray-800\">Video Codec Compare</h2>\n    <span class=\"text-xs font-mono text-gray-400\">v1.1.0</span>\n  </div>\n  <p class=\"text-sm text-gray-600 mt-2\">Shrinks a video exactly the way Sune does before attaching it (360p short side, 4 fps, mono AAC 32 kbps), once as HEVC and once as H.264, so you can compare the sizes this device produces. Nothing is sent anywhere.</p>\n  <div class=\"mt-3 grid grid-cols-2 gap-2 text-xs text-gray-600\">\n    <label>HEVC kbps<input id=\"vcc-hevc\" type=\"number\" min=\"10\" value=\"130\" class=\"mt-1 w-full rounded-lg border border-gray-300 bg-white px-2 py-1.5 text-sm text-gray-900\"></label>\n    <label>H.264 kbps<input id=\"vcc-avc\" type=\"number\" min=\"10\" value=\"160\" class=\"mt-1 w-full rounded-lg border border-gray-300 bg-white px-2 py-1.5 text-sm text-gray-900\"></label>\n  </div>\n  <p class=\"mt-1 text-[11px] text-gray-400\">130 / 160 are Sune's defaults. Set both the same to compare quality at equal size.</p>\n  <label id=\"vcc-pick\" class=\"mt-3 block w-full rounded-xl bg-gray-900 text-white py-2.5 text-sm font-medium text-center cursor-pointer active:scale-[.98] transition\">Pick a video<input id=\"vcc-file\" type=\"file\" accept=\"video/*\" class=\"hidden\"></label>\n  <p id=\"vcc-src\" class=\"mt-3 text-xs text-gray-500 whitespace-pre-line\"></p>\n  <div id=\"vcc-out\" class=\"mt-2 space-y-2\"></div>\n  <p id=\"vcc-sum\" class=\"mt-3 text-sm font-medium text-gray-800\"></p>\n</div>\n<script type=\"module\">\n// @mediabunny/aac-encoder@1.61.6 imports mediabunny@1.61.5 on jsDelivr, so load that same build to share one instance (AAC fallback registers on it)\nconst MB = 'https://cdn.jsdelivr.net/npm/mediabunny@1.61.5/+esm', AAC = 'https://cdn.jsdelivr.net/npm/@mediabunny/aac-encoder@1.61.6/+esm'\nconst $ = id => document.getElementById(id), root = $('vcc')\n// Same constants as sune/src/video.js\nconst SHORT_SIDE = 360, FPS = 4, AUDIO_BPS = 32e3, NAMES = { hevc: 'HEVC (H.265)', avc: 'H.264' }\nconst even = n => Math.max(2, Math.round(n / 2) * 2)\nconst sz = n => n >= 1048576 ? (n / 1048576).toFixed(2) + ' MB' : (n / 1024).toFixed(1) + ' KB'\nconst kbps = (n, d) => d ? Math.round(n * 8 / d / 1000) + ' kbps' : '?'\nconst b64Len = n => 'data:video/mp4;base64,'.length + Math.ceil(n / 3) * 4\nconst urls = [], drop = () => urls.splice(0).forEach(u => URL.revokeObjectURL(u))\nlet mbP, busy\nconst load = () => mbP ||= (async () => {\n  const m = await import(MB)\n  if (!(await m.canEncodeAudio('aac', { numberOfChannels: 1, sampleRate: 48000, bitrate: AUDIO_BPS }))) (await import(AAC)).registerAacEncoder()\n  return m\n})()\n$('suneHtml')?.addEventListener('sune:unmount', drop, { once: true })\n\n// Mirror of compressVideo() with the codec forced instead of auto-picked\nasync function encode(file, codec, bps, onProgress) {\n  const { Input, Output, Conversion, ALL_FORMATS, BlobSource, BufferTarget, Mp4OutputFormat, Quality, canEncodeVideo } = await load()\n  const input = new Input({ source: new BlobSource(file), formats: ALL_FORMATS })\n  try {\n    const track = await input.getPrimaryVideoTrack()\n    if (!track) throw new Error('no video track')\n    const w = await track.getDisplayWidth(), h = await track.getDisplayHeight(), s = Math.min(1, SHORT_SIDE / Math.min(w, h)), width = even(w * s), height = even(h * s)\n    if (!(await canEncodeVideo(codec, { width, height, frameRate: FPS, bitrate: bps }))) return { unsupported: true }\n    const output = new Output({ format: new Mp4OutputFormat({ fastStart: 'in-memory' }), target: new BufferTarget() })\n    const video = { frameRate: FPS, codec, quality: new Quality({ bitrate: bps }), forceTranscode: true }\n    if (await track.getFlip()) Object.assign(video, { width, height, fit: 'fill' })\n    else {\n      const cx = new OffscreenCanvas(width, height).getContext('2d'), rot = await track.getRotation()\n      cx.imageSmoothingQuality = 'high'\n      Object.assign(video, { process: f => (f.draw(cx, 0, 0, width, height), cx.canvas), processedWidth: width, processedHeight: height, rotate: (360 - rot) % 360 })\n    }\n    const conv = await Conversion.init({\n      input, output, tracks: 'primary', video,\n      audio: { numberOfChannels: 1, codec: 'aac', quality: new Quality({ bitrate: AUDIO_BPS }), forceTranscode: true }\n    })\n    if (!conv.isValid) throw new Error(conv.discardedTracks.map(t => t.reason).join(', ') || 'unsupported video')\n    conv.onProgress = onProgress\n    const t0 = performance.now()\n    await conv.execute()\n    return { buf: output.target.buffer, ms: performance.now() - t0, width, height }\n  } finally { input.dispose() }\n}\n\nasync function probe(file) {\n  const { Input, ALL_FORMATS, BlobSource } = await load(), input = new Input({ source: new BlobSource(file), formats: ALL_FORMATS })\n  try {\n    const t = await input.getPrimaryVideoTrack()\n    return { dur: await input.computeDuration(), w: await t?.getDisplayWidth(), h: await t?.getDisplayHeight(), codec: await t?.getCodec() }\n  } finally { input.dispose() }\n}\n\nfunction row(codec) {\n  const d = document.createElement('div')\n  d.className = 'rounded-xl border border-gray-200 bg-white p-3'\n  d.innerHTML = `<div class=\"flex justify-between text-sm\"><span class=\"font-medium text-gray-800\">${NAMES[codec]}</span><span data-r class=\"font-mono text-gray-500\">waiting</span></div>\n    <div class=\"mt-2 h-1.5 rounded-full bg-gray-100 overflow-hidden\"><div data-bar class=\"h-full w-0 bg-gray-900 transition-all\"></div></div>\n    <p data-info class=\"mt-2 text-xs text-gray-500 whitespace-pre-line\"></p><div data-media></div>`\n  $('vcc-out').append(d)\n  return k => d.querySelector(`[data-${k}]`)\n}\n\nasync function run(file) {\n  busy = true\n  drop()\n  $('vcc-pick').classList.add('opacity-50', 'pointer-events-none')\n  $('vcc-out').innerHTML = $('vcc-sum').textContent = ''\n  $('vcc-src').textContent = 'Loading Mediabunny\u2026'\n  try {\n    const src = await probe(file), res = {}\n    $('vcc-src').textContent = `Original: ${sz(file.size)} \u00b7 ${src.w}\u00d7${src.h} \u00b7 ${src.codec || '?'} \u00b7 ${src.dur.toFixed(1)} s`\n    for (const codec of ['hevc', 'avc']) {\n      const q = row(codec), bps = Math.max(10, +$('vcc-' + codec).value || 0) * 1e3\n      q('r').textContent = 'encoding 0%'\n      try {\n        const r = await encode(file, codec, bps, p => { q('bar').style.width = p * 100 + '%'; q('r').textContent = `encoding ${Math.round(p * 100)}%` })\n        if (r.unsupported) { q('r').textContent = 'not supported'; q('info').textContent = `This device can't encode ${NAMES[codec]} at these settings.`; continue }\n        res[codec] = r\n        const n = r.buf.byteLength, u = URL.createObjectURL(new Blob([r.buf], { type: 'video/mp4' }))\n        urls.push(u)\n        q('bar').style.width = '100%'\n        q('r').textContent = sz(n)\n        q('info').textContent = `${r.width}\u00d7${r.height} @ ${FPS} fps \u00b7 target ${bps / 1e3} kbps video + 32 kbps audio\\nActual ${kbps(n, src.dur)} total \u00b7 sent as ${sz(b64Len(n))} base64 \u00b7 ${(r.ms / 1000).toFixed(1)} s to encode`\n        q('media').innerHTML = `<video controls playsinline preload=\"metadata\" class=\"mt-2 w-full rounded-lg bg-black max-h-64\"></video><a download=\"${codec}-${FPS}fps.mp4\" class=\"mt-1 inline-block text-xs text-blue-600 underline\">Download</a>`\n        q('media').querySelector('video').src = u\n        q('media').querySelector('a').href = u\n      } catch (e) { q('r').textContent = 'failed'; q('info').textContent = String(e?.message || e) }\n    }\n    // Sune itself tries HEVC first, then H.264\n    const pick = ['hevc', 'avc'].find(c => res[c]), { hevc: a, avc: b } = res\n    $('vcc-sum').textContent = a && b\n      ? `HEVC is ${sz(Math.abs(b.buf.byteLength - a.buf.byteLength))} (${Math.abs(100 - a.buf.byteLength / b.buf.byteLength * 100).toFixed(1)}%) ${a.buf.byteLength <= b.buf.byteLength ? 'smaller' : 'larger'} than H.264. Sune uses HEVC on this device.`\n      : pick ? `Only ${NAMES[pick]} works here, so Sune uses ${NAMES[pick]} on this device.` : 'Neither codec could be encoded on this device.'\n  } catch (e) { $('vcc-src').textContent = 'Error: ' + (e?.message || e) }\n  finally { busy = false; $('vcc-pick').classList.remove('opacity-50', 'pointer-events-none') }\n}\n\nif (root) $('vcc-file').onchange = e => { const f = e.target.files?.[0]; e.target.value = ''; f && !busy && run(f) }\n</script>",
      "hide_composer": true
    },
    "storage": {}
  }
]
